# Copy to deploy/.env only for local fixtures; never commit a real token.
# Compose reads this file automatically when present, but the product image and
# deploy/compose.yaml never embed a token. Real deployments should export
# OPENLIST_TOKEN in the orchestrator or a secret store instead.
OPENLIST_TOKEN=strmgen-fixture-only
STRMGEN_UID=10001
STRMGEN_GID=10001
